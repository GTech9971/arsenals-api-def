{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "delete generated",
            "detail": "自動生成されたフォルダを削除",
            "command": "rm",
            "type": "shell",
            "group": "build",
            "args": [
                "-r",
                "generated-server",
            ],
            "problemMatcher": []
        },
        {
            "label": "generate - server",
            "detail": "サーバーサイドのコード自動生成",
            "command": "openapi-generator",
            "type": "shell",
            "group": "build",
            "args": [
                "generate",
                "-i",
                "./openapi.yaml",
                "-g",
                "aspnetcore",
                "-o",
                "./generated-server",
                "-c",
                "./server.config.json"
            ],
            "dependsOn": [
                "delete generated"
            ],
            "problemMatcher": []
        },
        {
            "label": "generate - client:typescript",
            "detail": "フロントエンドのコード自動生成",
            "command": "openapi-generator",
            "type": "shell",
            "group": "build",
            "args": [
                "generate",
                "-i",
                "./openapi.yaml",
                "-g",
                "typescript-fetch",
                "-o",
                "./generated-client-typescript",
                "-c",
                "typescript.config.json"
            ],
            "problemMatcher": []
        }
    ]
}