{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "validate",
            "detail": "openapiファイルのバリデーション",
            "command": "openapi-generator",
            "type": "shell",
            "group": "test",
            "args": [
                "validate",
                "-i",
                "root.yaml",
            ],
            "dependsOn": [
                "bundle"
            ]
        },
        {
            "label": "bundle",
            "detail": "openapiファイルを1ファイルに固める",
            "command": "redocly",
            "type": "shell",
            "group": "build",
            "args": [
                "bundle",
                "openapi.yaml",
                "--output",
                "root.yaml"
            ]
        },
        {
            "label": "delete generated - server",
            "detail": "自動生成されたフォルダを削除",
            "command": "rm",
            "type": "shell",
            "group": "build",
            "args": [
                "-rf",
                "generated-server",
            ]
        },
        {
            "label": "delete generated - client",
            "detail": "自動生成されたフォルダを削除",
            "command": "rm",
            "type": "shell",
            "group": "build",
            "args": [
                "-rf",
                "generated-client-typescript",
            ]
        },
        {
            "label": "generate - server:c#",
            "detail": "サーバーサイドのコード自動生成",
            "command": "openapi-generator",
            "type": "shell",
            "group": "build",
            "args": [
                "generate",
                "-i",
                "root.yaml",
                "-g",
                "aspnetcore",
                "-o",
                "generated-server",
                "-c",
                "server.config.json",
                "--model-name-suffix",
                "Model"
            ],
            "dependsOn": [
                "delete generated - server",
                "bundle"
            ],
        },
        {
            "label": "generate - client:typescript",
            "detail": "フロントエンドのコード自動生成",
            "command": "openapi-generator",
            "type": "shell",
            "group": "build",
            "args": [
                "generate",
                "-i",
                "root.yaml",
                "-g",
                "typescript-fetch",
                "-o",
                "generated-client-typescript",
                "-c",
                "typescript.config.json",
                "--git-user-id=GTech9971",
                "--git-repo-id=arsenals-api-def",
                "--additional-properties=npmVersion=1.0.0"
            ],
            "dependsOn": [
                "delete generated - client",
                "bundle",
            ]
        },
        {
            "label": "npm install",
            "command": "npm",
            "type": "shell",
            "group": "build",
            "args": [
                "install"
            ],
            "options": {
                "cwd": "generated-client-typescript"
            }
        },
        {
            "label": "npm publish dry",
            "detail": "フロントエンドのコード自動生成結果をpublish可能か確認する",
            "command": "npm",
            "type": "shell",
            "group": "build",
            "args": [
                "publish",
                "--dry-run",
            ],
            "options": {
                "cwd": "generated-client-typescript"
            },
            "dependsOn": [
                "generate - client:typescript",
                "npm install"
            ],
            //並列事項を拒否
            "dependsOrder": "sequence"
        }
    ]
}