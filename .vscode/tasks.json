{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "generate - server",
            "detail": "サーバーサイドのコード自動生成",
            "command": "openapi-generator",
            "type": "shell",
            "group": "build",
            "args": [
                "generate",
                "-i",
                "${input:apiDef}/openapi.yaml",
                "-g",
                "aspnetcore",
                "-o",
                "./${input:apiDef}/generated-server",
                "-c",
                "./server.config.json"
            ],
            "problemMatcher": []
        },
        {
            "label": "generate - client:typescript",
            "detail": "フロントエンドのコード自動生成",
            "command": "openapi-generator",
            "type": "shell",
            "group": "build",
            "args": [
                "generate",
                "-i",
                "${input:apiDef}/openapi.yaml",
                "-g",
                "typescript-fetch",
                "-o",
                "./${input:apiDef}/generated-client-typescript",
                "-c",
                "typescript.config.json"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "apiDef",
            "description": "APIの種類",
            "type": "pickString",
            "options": [
                "guns",
                "bullets"
            ]
        }
    ]
}