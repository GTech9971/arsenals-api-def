{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "validate",
            "detail": "openapiファイルのバリデーション",
            "command": "openapi-generator",
            "type": "shell",
            "group": "test",
            "args": [
                "validate",
                "-i",
                "root.yaml",
            ],
            "problemMatcher": [],
            "dependsOn": [
                "bundle"
            ]
        },
        {
            "label": "bundle",
            "detail": "openapiファイルを1ファイルに固める",
            "command": "redocly",
            "type": "shell",
            "group": "build",
            "args": [
                "bundle",
                "openapi.yaml",
                "--output",
                "root.yaml"
            ],
            "problemMatcher": []
        },
        {
            "label": "delete generated",
            "detail": "自動生成されたフォルダを削除",
            "command": "rm",
            "type": "shell",
            "group": "build",
            "args": [
                "-rf",
                "generated-server",
            ],
            "problemMatcher": []
        },
        {
            "label": "generate - server:c#",
            "detail": "サーバーサイドのコード自動生成",
            "command": "openapi-generator",
            "type": "shell",
            "group": "build",
            "args": [
                "generate",
                "-i",
                "root.yaml",
                "-g",
                "aspnetcore",
                "-o",
                "generated-server",
                "-c",
                "server.config.json",
                "--model-name-suffix",
                "Model"
            ],
            "dependsOn": [
                "delete generated",
                "bundle"
            ],
            "problemMatcher": []
        },
        {
            "label": "generate - client:typescript",
            "detail": "フロントエンドのコード自動生成",
            "command": "openapi-generator",
            "type": "shell",
            "group": "build",
            "args": [
                "generate",
                "-i",
                "root.yaml",
                "-g",
                "typescript-fetch",
                "-o",
                "generated-client-typescript",
                "-c",
                "typescript.config.json"
            ],
            "problemMatcher": [],
            "dependsOn": [
                "bundle",
            ]
        }
    ]
}